---
import { NAV } from "./../constants";
import { isActiveLink } from "./../utils";

const pathname = new URL(Astro.url).pathname;




const navMain = NAV.filter((item) => item.type === "MAIN");
console.log(navMain);
---
<h1>Navigation Main</h1>

<nav class="navigation-main">
	<ul>
		{navMain.map((item) => (
			<li class="nav-item"><a class:list={['nav-link', { active: isActiveLink(pathname, item.href) }]} href={item.href}>{item.name}</a></li>
		))}
	</ul>

</nav>

<style>
	.navigation-main .nav-link.active {
		font-weight: bold;
	}
</style>


