---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getFormattedDate } from '../../utils.ts';

const posts = await getCollection('posts');
console.log(posts);
---
<Layout title="Posts" description="A list of all posts">
    <h1>Posts</h1>
    <ul>
        {posts.map((post) => (
            <li>
                <a href={`/posts/${post.id}`}>{post.data.title} ({getFormattedDate(new Date(post.data.date))})</a>
            </li>
        ))}
    </ul>
</Layout>